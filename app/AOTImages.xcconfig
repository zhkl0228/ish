// The AOT images the ARM64 app links: generated by benchmark/aojit/publish_app_images.py
// from benchmark/aojit/app-images.lock.json, do not edit. app/fetch-aot.py fetches them
// into build/aot/<set>/ in the build (Build Meson (ARM64)), before the app links.
ISH_AOT_SET = 54b20452-20261127-5ceadcd2
ISH_AOT_OBJECTS = $(SRCROOT)/build/aot/$(ISH_AOT_SET)/aot_bash_ios.o $(SRCROOT)/build/aot/$(ISH_AOT_SET)/aot_busybox_ios.o $(SRCROOT)/build/aot/$(ISH_AOT_SET)/aot_claude_ios.o $(SRCROOT)/build/aot/$(ISH_AOT_SET)/aot_crypto_ios.o $(SRCROOT)/build/aot/$(ISH_AOT_SET)/aot_gh_ios.o $(SRCROOT)/build/aot/$(ISH_AOT_SET)/aot_git_ios.o $(SRCROOT)/build/aot/$(ISH_AOT_SET)/aot_jvm_ios.o $(SRCROOT)/build/aot/$(ISH_AOT_SET)/aot_musl_ios.o $(SRCROOT)/build/aot/$(ISH_AOT_SET)/aot_node_ios.o $(SRCROOT)/build/aot/$(ISH_AOT_SET)/aot_python_ios.o $(SRCROOT)/build/aot/$(ISH_AOT_SET)/aot_ssh_ios.o
