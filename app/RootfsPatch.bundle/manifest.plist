<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>version</key>
    <integer>34</integer>
    <key>files</key>
    <array>
        <dict>
            <key>src</key>
            <string>files/lib/wasm-polyfill.js</string>
            <key>dst</key>
            <string>/lib/wasm-polyfill.js</string>
        </dict>
        <dict>
            <key>src</key>
            <string>files/lib/fetch-polyfill.js</string>
            <key>dst</key>
            <string>/lib/fetch-polyfill.js</string>
        </dict>
        <dict>
            <key>src</key>
            <string>files/etc/motd</string>
            <key>dst</key>
            <string>/etc/motd</string>
        </dict>
        <dict>
            <key>src</key>
            <string>files/etc/profile.d/ish-aliases.sh</string>
            <key>dst</key>
            <string>/etc/profile.d/ish-aliases.sh</string>
        </dict>
        <!-- node's compile cache, for the next run of a program -->
        <dict>
            <key>src</key>
            <string>files/etc/profile.d/ish-node.sh</string>
            <key>dst</key>
            <string>/etc/profile.d/ish-node.sh</string>
        </dict>
        <!-- JAVA_HOME, once ish-install java has installed the JDK -->
        <dict>
            <key>src</key>
            <string>files/etc/profile.d/ish-java.sh</string>
            <key>dst</key>
            <string>/etc/profile.d/ish-java.sh</string>
        </dict>
        <!-- a restored tab's directory; bash history kept as commands run -->
        <dict>
            <key>src</key>
            <string>files/etc/profile.d/ish-session.sh</string>
            <key>dst</key>
            <string>/etc/profile.d/ish-session.sh</string>
        </dict>
        <!-- imported Claude global memory, synchronized without overwriting edits -->
        <dict>
            <key>src</key>
            <string>files/etc/profile.d/ish-claude-memory.sh</string>
            <key>dst</key>
            <string>/etc/profile.d/ish-claude-memory.sh</string>
        </dict>
        <!-- BROWSER: xdg-open, for the programs that open one -->
        <dict>
            <key>src</key>
            <string>files/etc/profile.d/ish-browser.sh</string>
            <key>dst</key>
            <string>/etc/profile.d/ish-browser.sh</string>
        </dict>
        <!-- the login shells ish-install zsh and ish-install fish make root's:
             zsh set up for a phone's keyboard; fish given /etc/profile's
             environment and directory, which it does not read -->
        <dict>
            <key>src</key>
            <string>files/etc/zsh/zshrc.d/ish.zsh</string>
            <key>dst</key>
            <string>/etc/zsh/zshrc.d/ish.zsh</string>
        </dict>
        <dict>
            <key>src</key>
            <string>files/etc/fish/conf.d/ish.fish</string>
            <key>dst</key>
            <string>/etc/fish/conf.d/ish.fish</string>
        </dict>
        <!-- says how to install them, until one is installed -->
        <dict>
            <key>src</key>
            <string>files/etc/profile.d/ish-install.sh</string>
            <key>dst</key>
            <string>/etc/profile.d/ish-install.sh</string>
        </dict>
        <!-- the time zone: Los Angeles. The zone file is all of tzdata a
             root needs for it; /etc/localtime links to it, as Alpine's
             setup-timezone does, so that programs find its name too (ICU,
             Python's tzlocal), and /etc/timezone names it. -->
        <dict>
            <key>src</key>
            <string>files/usr/share/zoneinfo/America/Los_Angeles</string>
            <key>dst</key>
            <string>/usr/share/zoneinfo/America/Los_Angeles</string>
        </dict>
        <dict>
            <key>dst</key>
            <string>/etc/localtime</string>
            <key>link</key>
            <string>/usr/share/zoneinfo/America/Los_Angeles</string>
        </dict>
        <dict>
            <key>src</key>
            <string>files/etc/timezone</string>
            <key>dst</key>
            <string>/etc/timezone</string>
        </dict>
        <!-- checks the configured proxy before starting the separately installed CLI -->
        <dict>
            <key>src</key>
            <string>files/usr/libexec/claude-wrapper</string>
            <key>dst</key>
            <string>/usr/libexec/claude-wrapper</string>
            <!-- 0755 -->
            <key>mode</key>
            <integer>493</integer>
        </dict>
        <dict>
            <key>dst</key>
            <string>/usr/local/bin/claude</string>
            <key>link</key>
            <string>/usr/libexec/claude-wrapper</string>
        </dict>
        <!-- installs the development tools the root leaves out -->
        <dict>
            <key>src</key>
            <string>files/usr/local/bin/ish-install</string>
            <key>dst</key>
            <string>/usr/local/bin/ish-install</string>
            <!-- 0755 -->
            <key>mode</key>
            <integer>493</integer>
        </dict>
        <!-- opens a URL once you allow it in the app (/proc/ish/open_url) -->
        <dict>
            <key>src</key>
            <string>files/usr/local/bin/xdg-open</string>
            <key>dst</key>
            <string>/usr/local/bin/xdg-open</string>
            <!-- 0755 -->
            <key>mode</key>
            <integer>493</integer>
        </dict>
        <!-- what the screen shows of iSH, a PNG for Claude Code to look at (/proc/ish/screenshot) -->
        <dict>
            <key>src</key>
            <string>files/usr/local/bin/ish-screenshot</string>
            <key>dst</key>
            <string>/usr/local/bin/ish-screenshot</string>
            <!-- 0755 -->
            <key>mode</key>
            <integer>493</integer>
        </dict>
        <!-- the npm tools' versions ish-install installs: those the app's AOT images serve
             (benchmark/aojit/publish_app_images.py writes it, and raises the version above) -->
        <dict>
            <key>src</key>
            <string>files/usr/local/share/ish-install/versions</string>
            <key>dst</key>
            <string>/usr/local/share/ish-install/versions</string>
        </dict>
        <!-- the boot OpenRC would do, which init runs (user accounting:
             utmpd and the rest, for w and who) -->
        <dict>
            <key>src</key>
            <string>files/usr/libexec/ish-sysinit</string>
            <key>dst</key>
            <string>/usr/libexec/ish-sysinit</string>
            <!-- 0755 -->
            <key>mode</key>
            <integer>493</integer>
        </dict>
        <dict>
            <key>src</key>
            <string>files/etc/inittab</string>
            <key>dst</key>
            <string>/etc/inittab</string>
        </dict>
    </array>
</dict>
</plist>
