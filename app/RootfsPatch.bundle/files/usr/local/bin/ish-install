#!/bin/sh
# Install the development tools the root leaves out.
#
#   ish-install              install every group
#   ish-install go python    install those groups
#   ish-install --cn ...     the same, from Alibaba Cloud's mirrors (in China)
#   ish-install -l           list the groups, and which are installed
#   ish-install zsh          zsh, set up for typing on a phone, as root's login
#                            shell (fish the same; bash: bash again). Only
#                            when named, one of them.
#
# A group already installed is skipped. Packages come from Alpine's
# repositories (apk), and Claude Code and Kimi Code from npm, so this needs the
# network. Claude Code and Kimi Code at the versions in VERSIONS: the app's AOT
# images serve those builds, and a tool of another version is installed again
# at its own. --cn makes apk, npm, pip and go use Alibaba Cloud's mirrors from
# then on: /etc/apk/repositories, and /etc/profile.d/ish-mirror-cn.sh for the
# others.
#
# Installed by the iSH app (RootfsPatch.bundle), which rewrites this file when
# it updates the root.
set -e

ALL_GROUPS="python node claude kimi go java c clang db tools svn"
# The login shells: root's, whom the app's launch command (login -f root) logs
# in, is the one last installed. Not among ALL_GROUPS: only when named.
SHELL_GROUPS="bash zsh fish"

# --cn: apk's repositories on mirrors.aliyun.com, and for login shells (and
# what they start: Claude Code's own updates too) npm on npmmirror, pip and go
# on mirrors.aliyun.com. go checks modules against sum.golang.org, which China
# does not reach either: its mirror is sum.golang.google.cn.
CN_PROFILE=/etc/profile.d/ish-mirror-cn.sh
use_cn_mirrors() {
    sed -i 's|https://dl-cdn.alpinelinux.org/alpine/|https://mirrors.aliyun.com/alpine/|' /etc/apk/repositories
    cat > "$CN_PROFILE" <<'EOF'
# Written by ish-install --cn: Alibaba Cloud's mirrors for npm, pip and go.
# Remove this file, and put https://dl-cdn.alpinelinux.org/alpine/ back in
# /etc/apk/repositories, for the official ones.
export NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
export PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
export GOPROXY=https://mirrors.aliyun.com/goproxy/,direct
export GOSUMDB=sum.golang.google.cn
EOF
    # shellcheck disable=SC1090
    . "$CN_PROFILE"
    echo "apk, npm, pip and go use Alibaba Cloud's mirrors now (this shell's npm, pip and go once you run: . $CN_PROFILE)"
}


describe() {
    case $1 in
        python) echo "Python 3, pip, cryptography, PyYAML      ~55 MB" ;;
        node)   echo "Node.js and npm                          ~60 MB" ;;
        claude) echo "Claude Code (and node)                   ~410 MB" ;;
        kimi)   echo "Kimi Code (and node)                     ~120 MB" ;;
        go)     echo "Go                                       ~175 MB" ;;
        java)   echo "OpenJDK 25, Maven, gcompat               ~360 MB" ;;
        c)      echo "gcc, cmake, meson, autotools, bison      ~370 MB" ;;
        clang)  echo "clang 22 (and build-base)                ~490 MB" ;;
        db)     echo "Redis, MariaDB server and client         ~230 MB" ;;
        tools)  echo "GitHub CLI, ShellCheck, 7-Zip            ~65 MB" ;;
        svn)    echo "Subversion (svn)                         ~6 MB" ;;
        bash)   echo "bash, the root's own                     ~0 MB" ;;
        zsh)    echo "zsh, suggestions and highlighting        ~6 MB" ;;
        fish)   echo "fish                                     ~13 MB" ;;
    esac
}

packages() {
    case $1 in
        python) echo "python3 py3-pip py3-pysocks py3-cryptography py3-yaml" ;;
        node)   echo "nodejs npm" ;;
        claude) echo "nodejs npm" ;;
        kimi)   echo "nodejs npm" ;;
        go)     echo "go" ;;
        # openjdk25-jdk first, so it is the java-jdk maven depends on. gcompat
        # runs the glibc binaries Maven plugins download for linux-aarch_64,
        # such as protoc-gen-grpc-java (protoc itself is static).
        java)   echo "openjdk25-jdk maven gcompat" ;;
        c)      echo "build-base cmake meson pkgconf autoconf automake libtool bison flex" ;;
        clang)  echo "build-base clang22" ;;
        db)     echo "redis mariadb mariadb-client" ;;
        tools)  echo "github-cli shellcheck 7zip" ;;
        svn)    echo "subversion" ;;
        bash)   echo "bash" ;;
        zsh)    echo "zsh zsh-autosuggestions zsh-syntax-highlighting" ;;
        fish)   echo "fish" ;;
    esac
}

# The login shell of a group of SHELL_GROUPS; nothing for another group. Its
# settings are the app's: /etc/zsh/zshrc.d/ish.zsh, /etc/fish/conf.d/ish.fish.
login_shell() {
    case $1 in
        bash) echo /bin/bash ;;
        zsh)  echo /bin/zsh ;;
        fish) echo /usr/bin/fish ;;
    esac
}

# root's login shell, as /etc/passwd has it
root_shell() {
    awk -F: '$1 == "root" { print $7 }' /etc/passwd
}

# The npm tools' versions the app's AOT images serve, a package and its version
# a line (benchmark/aojit/publish_app_images.py writes it; the app installs it
# with this file)
VERSIONS=/usr/local/share/ish-install/versions

# The version VERSIONS gives package: nothing for a package it does not name
pinned() {
    awk -v p="$1" '!/^#/ && $1 == p { print $2 }' "$VERSIONS"
}

# The version of the tool has_tool found: its package.json's, in its directory or
# npm's global one (npm -g installs into /usr/local); nothing for a tool found on
# the PATH some other way
tool_version() {
    pj=${prefix:-/usr/local}/lib/node_modules/$package/package.json
    [ -f "$pj" ] || return 0
    sed -n 's/^ *"version": *"\([^"]*\)".*/\1/p' "$pj" | head -n 1
}

# Whether the tool has_tool found is the version VERSIONS gives, if it gives one
tool_current() {
    want=$(pinned "$package")
    [ -z "$want" ] || [ "$(tool_version)" = "$want" ]
}

# The groups with a tool from npm: its command, its package and, for a tool
# npm installs into a directory of its own (npm -g --prefix), that directory.
# Installed with npm -g, the way the tool's own updater expects to update it.
npm_tool() {
    case $1 in
        claude) echo "claude @anthropic-ai/claude-code /opt/claude-code" ;;
        kimi)   echo "kimi @moonshot-ai/kimi-code" ;;
    esac
}

# Whether npm_tool's tool is there: in its directory, or on the PATH. Sets
# cmd, package and prefix from it.
has_tool() {
    read -r cmd package prefix <<EOF
$1
EOF
    if [ -n "$prefix" ]; then
        [ -x "$prefix/bin/$cmd" ]
    else
        command -v "$cmd" > /dev/null
    fi
}

# apk info -e names the packages given that are installed
installed() {
    # shellcheck disable=SC2046
    [ "$(apk info -e $(packages "$1") | wc -l)" -eq "$(packages "$1" | wc -w)" ] || return 1
    shell=$(login_shell "$1")
    [ -z "$shell" ] || [ "$(root_shell)" = "$shell" ] || return 1
    tool=$(npm_tool "$1")
    [ -z "$tool" ] || { has_tool "$tool" && tool_current; }
}

list() {
    for group in $ALL_GROUPS $SHELL_GROUPS; do
        if installed "$group"; then
            state=installed
            [ -z "$(login_shell "$group")" ] || state="root's login shell"
        elif tool=$(npm_tool "$group") && [ -n "$tool" ] && has_tool "$tool"; then
            state="installed $(tool_version), the app's AOT image is for $(pinned "$package")"
        else
            state=
        fi
        printf '  %-8s %s  %s\n' "$group" "$(describe "$group")" "$state"
    done
}

case $1 in
    -l|--list)
        list
        exit 0 ;;
    -h|--help)
        echo "usage: ish-install [--cn] [group...]   (every group if none is given;"
        echo "                                        --cn: from Alibaba Cloud's mirrors, from then on)"
        echo "       ish-install zsh|fish|bash       (that one as root's login shell; only when named)"
        echo "       ish-install -l                  (the groups, and which are installed)"
        echo
        list
        exit 0 ;;
esac

wanted='' cn='' shells=''
for arg in "$@"; do
    if [ "$arg" = --cn ]; then
        cn=1
        continue
    fi
    if [ -z "$(packages "$arg")" ]; then
        echo "ish-install: no group $arg; groups: $ALL_GROUPS $SHELL_GROUPS" >&2
        exit 2
    fi
    [ -z "$(login_shell "$arg")" ] || shells="$shells $arg"
    wanted="$wanted $arg"
done
if [ "$(echo $shells | wc -w)" -gt 1 ]; then
    echo "ish-install:$shells: root has one login shell; name one" >&2
    exit 2
fi
[ -n "$wanted" ] || wanted=$ALL_GROUPS
[ -z "$cn" ] || use_cn_mirrors

todo='' pkgs=''
for group in $wanted; do
    if installed "$group"; then
        echo "$group: already installed"
        continue
    fi
    todo="$todo $group"
    pkgs="$pkgs $(packages "$group")"
done
[ -n "$todo" ] || exit 0

echo "installing:$todo"
# shellcheck disable=SC2086
apk add --no-cache $pkgs
npm_installed=''
for group in $todo; do
    tool=$(npm_tool "$group")
    [ -n "$tool" ] || continue
    if has_tool "$tool"; then
        tool_current && continue
        echo "$group: $package $(tool_version) is installed, the app's AOT image is for $(pinned "$package"): installing that"
    fi
    version=$(pinned "$package")
    if [ -n "$prefix" ]; then
        npm install -g --prefix "$prefix" --no-audit --no-fund "$package${version:+@$version}"
    else
        npm install -g --no-audit --no-fund "$package${version:+@$version}"
    fi
    npm_installed=1
done
[ -z "$npm_installed" ] || npm cache clean --force 2> /dev/null
for group in $todo; do
    shell=$(login_shell "$group")
    [ -n "$shell" ] || continue
    sed -i "s|^\(root:\([^:]*:\)\{5\}\).*|\1$shell|" /etc/passwd
    if [ "$(root_shell)" != "$shell" ]; then
        echo "ish-install: root's line in /etc/passwd does not end in $shell: $(grep '^root:' /etc/passwd)" >&2
        exit 1
    fi
    back='; bash again: ish-install bash'
    [ "$group" != bash ] || back=''
    echo "root logs in to $group from the next tab (this one: exec $shell -l$back)"
done
echo "installed:$todo"
case " $todo " in
    *" java "*)
        JAVA_PROFILE=/etc/profile.d/ish-java.sh
        echo "JAVA_HOME is /usr/lib/jvm/default-jvm in login shells (this shell's once you run: . $JAVA_PROFILE)" ;;
esac
