#!/bin/sh
# Installed by the iSH app, which rewrites this file when it updates the root.
# Claude Code, which ish-install puts in /opt/claude-code, with the Proxy chosen
# in iSH's Settings: none, or an HTTPS one, and then only with its exit in
# California.
# --version and --help reach no server: they run as they are.

claude=/opt/claude-code/bin/claude
if [ ! -x "$claude" ]; then
    echo 'claude: Claude Code is not installed; run ish-install claude first' >&2
    exit 1
fi

case $1 in
    -v|--version|-h|--help) exec "$claude" "$@" ;;
esac

# Claude Code tells of what wants you (a question for you, a turn ended) with
# a terminal's notifications only in terminals it knows by name; elsewhere its
# "auto" tells nothing. iSH's terminal takes iTerm2's (OSC 9) as the app's
# notifications and its tabs' bells: set once in Claude's global config, if
# not set there already, which the first run makes.
config=${CLAUDE_CONFIG_DIR:-$HOME}/.claude.json
if [ -e "$config" ]; then
    jq -e 'has("preferredNotifChannel")' "$config" >/dev/null
    case $? in
        0) ;;
        1)
            tmp=$(mktemp "$config.XXXXXX") &&
                jq '.preferredNotifChannel = "iterm2"' "$config" >"$tmp" &&
                mv "$tmp" "$config"
            ;;
        *) echo "claude: $config is not a JSON object jq reads; notifications left as they are" >&2 ;;
    esac
fi

# Claude's Proxy in iSH's Settings: None is claude_no_proxy true; HTTPS is
# false, or no claude_no_proxy with a claude_proxy (set before there was a
# choice), its URL a JSON string
no_proxy_setting=/proc/ish/defaults/claude_no_proxy
proxy_setting=/proc/ish/defaults/claude_proxy
choose='claude: choose Proxy under Claude in iSH Settings first: None, or HTTPS and its URL — aborting'
if [ -e "$no_proxy_setting" ]; then
    none=$(jq . "$no_proxy_setting") || exit 1
elif [ -e "$proxy_setting" ]; then
    none=false
else
    echo "$choose" >&2
    exit 1
fi
case $none in
    true)
        # None: Claude Code goes out on the device's own network (iOS's VPN, if
        # one is on), whatever proxy the shell's variables name; its exit is
        # not checked
        unset HTTPS_PROXY HTTP_PROXY https_proxy http_proxy
        ;;
    false)
        if [ ! -e "$proxy_setting" ]; then
            echo "$choose" >&2
            exit 1
        fi
        proxy=$(jq -r . "$proxy_setting") || exit 1
        case $proxy in
            https://*) ;;
            *)
                echo "claude: Claude's HTTPS proxy must be an https:// URL, not $proxy — aborting" >&2
                exit 1
                ;;
        esac

        # The exit as ipinfo.io sees it: {"ip", "city", "region", "country", "org", ...}
        if ! info=$(curl -sS --fail --connect-timeout 5 --max-time 15 -x "$proxy" https://ipinfo.io); then
            echo "claude: ipinfo.io through $proxy failed — aborting" >&2
            exit 1
        fi
        if ! exit_line=$(printf '%s' "$info" | jq -r '"\(.ip)  ·  \(.city), \(.region), \(.country)  ·  \(.org)"'); then
            echo "claude: ipinfo.io answered: $info — aborting" >&2
            exit 1
        fi
        echo "Claude exit: $exit_line" >&2
        region=$(printf '%s' "$info" | jq -r .region)
        if [ "$region" != California ]; then
            echo "claude: the exit is in $region, not California — aborting" >&2
            exit 1
        fi

        export HTTPS_PROXY="$proxy" HTTP_PROXY="$proxy" https_proxy="$proxy" http_proxy="$proxy"
        # Not through the proxy: this device, and the mirrors ish-install --cn sets
        # (Claude Code updating itself from npmmirror by way of California is slow)
        export NO_PROXY="localhost,127.0.0.1,mirrors.aliyun.com,npmmirror.com"
        export no_proxy="$NO_PROXY"
        ;;
    *)
        echo "claude: $no_proxy_setting is $none, not true or false — aborting" >&2
        exit 1
        ;;
esac

# Claude Code updates itself with `npm install -g`, into npm's global prefix
# (/usr/local): its updates go where ish-install put it instead
export NPM_CONFIG_PREFIX=/opt/claude-code
# But not of itself: the app's AOT image of claude.exe serves the version it
# was recorded from (/usr/local/share/ish-install/versions), which ish-install
# installs; an update would run on without most of it. A new version comes
# with an app whose images were recorded on it (benchmark/aojit/README.md).
export DISABLE_AUTOUPDATER=1
# JavaScriptCore's JIT off, unless BUN_JSC_useJIT is set already: no AOT image
# can serve the code it writes at run time, which runs through iSH's gadgets,
# and its compiler threads take CPU of their own, while its interpreter (LLInt)
# is claude.exe's own code, which the image serves (98% of its blocks, as with
# the JIT). Measured in the app (2026-11-24, its images): print mode 6.6 s of
# CPU -> 6.1 s, a session with tools 5.0 -> 4.5 s, in the same wall time or
# less. As kernel/exec.c runs node: in V8's interpreter.
export BUN_JSC_useJIT="${BUN_JSC_useJIT:-0}"
# Of another version than the image was recorded on (an app updated since it
# was installed), the image serves it only in part (half its blocks): said,
# with what installs that version where it is (ish-install -u: npm -g --prefix
# /opt/claude-code)
want=$(awk '$1 == "npm" && $2 == "@anthropic-ai/claude-code" { print $3 }' /usr/local/share/ish-install/versions)
have=$(jq -r .version /opt/claude-code/lib/node_modules/@anthropic-ai/claude-code/package.json)
if [ "$have" != "$want" ]; then
    echo "claude: Claude Code $have; the app's AOT image is of $want, and serves this one only in part: ish-install -u installs it" >&2
fi
exec "$claude" "$@"
