// The Live Activity extension (app/LiveActivity): the tabs' Claude Code on
// the Dynamic Island and the Lock Screen, which the iSH-ARM64 host app
// starts and tells (app/AgentActivityTracker.m).
#include "iOS.xcconfig"

INFOPLIST_FILE = app/LiveActivity/Info.plist
PRODUCT_NAME = $(TARGET_NAME)
SKIP_INSTALL = YES
SWIFT_VERSION = 5.0
APPLICATION_EXTENSION_API_ONLY = YES

// The identifier of the iSH-ARM64 host app's extension (as AppARM64.xcconfig's).
PRODUCT_BUNDLE_IDENTIFIER = $(ROOT_BUNDLE_IDENTIFIER).arm64.LiveActivity

// Must match the host app (AppARM64.xcconfig): iOS rejects an extension
// whose version differs from its containing app.
MARKETING_VERSION = 2.3.5
CURRENT_PROJECT_VERSION = 854
