// The share extension (app/Share): what other apps share with iSH, left in
// the app group for the iSH-ARM64 host app to move into its Documents' inbox
// (app/ShareInbox.h).
#include "iOS.xcconfig"

CODE_SIGN_ENTITLEMENTS = app/Share/Share.entitlements
INFOPLIST_FILE = app/Share/Info.plist
PRODUCT_NAME = $(TARGET_NAME)
SKIP_INSTALL = YES
APPLICATION_EXTENSION_API_ONLY = YES

// The identifiers of the iSH-ARM64 host app's extension (as AppARM64.xcconfig's).
PRODUCT_BUNDLE_IDENTIFIER = $(ROOT_BUNDLE_IDENTIFIER).arm64.Share
PRODUCT_APP_GROUP_IDENTIFIER = group.$(ROOT_BUNDLE_IDENTIFIER).arm64

// app/AppGroup.h, app/ShareInbox.h
HEADER_SEARCH_PATHS = $(inherited) $(SRCROOT)/app

// Must match the host app (AppARM64.xcconfig): iOS rejects an extension
// whose version differs from its containing app.
MARKETING_VERSION = 2.3.5
CURRENT_PROJECT_VERSION = 853
