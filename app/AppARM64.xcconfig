#include "App.xcconfig"
#include "GuestARM64.xcconfig"

// The app's name and identifiers, as they were when an x86 app was built
// beside it: kept, so that an installed app stays the same app, its data with
// it
PRODUCT_NAME = iSH ARM64
PRODUCT_BUNDLE_IDENTIFIER = $(ROOT_BUNDLE_IDENTIFIER).arm64
PRODUCT_APP_GROUP_IDENTIFIER = group.$(ROOT_BUNDLE_IDENTIFIER).arm64

// The app version.
MARKETING_VERSION = 2.3.5

// Build number must increase across the whole app regardless of marketing
// version. CI (.github/workflows/aot-images.yml) raises it by one, and each
// extension's *ARM64.xcconfig with it, with each set of AOT images it commits.
CURRENT_PROJECT_VERSION = 849

// Link meson-built libraries directly from the arm64 meson build dir.
// These are NOT in the Frameworks build phase to prevent Xcode from
// auto-discovering implicit dependencies on the library targets (libish,
// libish_emu, libfakefs). libish's platform/darwin.c reads the app's
// entitlements with Security's SecTask. The on-device pairing's idevice
// (OnDevicePairing.m): app/idevice/build.sh builds it into build/idevice.
OTHER_LDFLAGS = $(inherited) $(MESON_BUILD_DIR)/libish.a $(MESON_BUILD_DIR)/libish_emu.a $(MESON_BUILD_DIR)/libfakefs.a $(ISH_AOT_OBJECTS) -framework Security $(SRCROOT)/build/idevice/libidevice_ffi.a

// AOT images the app links in as extra objects: aot_<name>.S from
// tools/jit_aot/gen.py, assembled for iOS, passed as .o paths. They are not
// part of ish and need ISH_ENABLE_JIT = YES (see GuestARM64.xcconfig and
// asbestos/guest-arm64/aot.h). AOTImages.xcconfig names the published set
// (benchmark/aojit/app-images.lock.json), which app/fetch-aot.py fetches in
// the Build Meson (ARM64) phase. app/AOTImages.local.xcconfig (not committed;
// benchmark/aojit/README.md) overrides it with images of one's own, or none:
//   ISH_AOT_OBJECTS = $(SRCROOT)/benchmark/aojit/images/<abi>/app/aot_musl_ios.o ...
// The images must match the build's abi (JIT_CODE_VERSION), or ish rejects them.
#include "AOTImages.xcconfig"
#include? "AOTImages.local.xcconfig"

// Swift (app/LiveActivity's AgentActivity): its interface for the
// Objective-C sources under one name, iSH-Swift.h, which the ffmpeg
// variant's module (of another product name) has too
SWIFT_VERSION = 5.0
SWIFT_OBJC_INTERFACE_HEADER_NAME = iSH-Swift.h

// Header search paths needed for sources compiled directly in this target
// (previously compiled in libiSHApp, which used AppLib.xcconfig)
HEADER_SEARCH_PATHS = $(inherited) $(SRCROOT) $(SRCROOT)/deps/sqlite $(SRCROOT)/deps/libarchive/libarchive $(SRCROOT)/build/idevice
