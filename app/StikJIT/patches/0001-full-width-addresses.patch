StikJIT 2.0.1: addresses of any width, where it wrote and read them with 36
and 40 bits (its page writer, and the scripts' register helpers), and a page
write the debug stub refused taken for a failure. iSH has the extended
virtual addressing entitlement: the region the debugger allocates may lie
above 2^36 (tctiSH saw it at 0x70_0000_0000, and patched the same).

diff -ruN a/Sources/ScriptRunner.swift b/Sources/ScriptRunner.swift
--- a/Sources/ScriptRunner.swift
+++ b/Sources/ScriptRunner.swift
@@ -5,7 +5,11 @@
 final class ScriptRunner {
 
     private static let jitPageSize: UInt64 = 16384
-    private static let jitPageCommandLength = 19
+    // $M<16 hex digits>,1:69#cc: a page address of any width (an app with the
+    // extended virtual addressing entitlement gets regions above 2^36, which
+    // 9 digits cut)
+    private static let jitPageAddressDigits = 16
+    private static let jitPageCommandLength = 26
     private static let commandsPerBatch = 128
 
     private let targetPID: Int32
@@ -90,16 +94,26 @@
                 return nil
             }
 
-            for _ in 0..<commandsInBatch {
+            for index in 0..<commandsInBatch {
                 var response: UnsafeMutablePointer<CChar>?
                 let readError = debug_proxy_read_response(debugProxy, &response)
+                var answer: String?
                 if let response {
+                    answer = String(cString: response)
                     idevice_string_free(response)
                 }
                 if let readError {
                     recordExecutionError(IdeviceFFI.consume(readError, fallback: "debug_proxy_read_response"))
                     return nil
                 }
+                // A write the stub refused leaves its page unprepared: the app
+                // would detach, go on, and be killed running code there
+                if let answer, answer.hasPrefix("E") {
+                    let page = UInt64(batchStart + index)
+                    recordExecutionError(.scriptExecution("writing the JIT page at 0x"
+                        + String(address + page * Self.jitPageSize, radix: 16) + " was refused: \(answer)"))
+                    return nil
+                }
             }
         }
 
@@ -121,24 +135,25 @@
             let pageAddress = startAddress + UInt64(page) * jitPageSize
             let start = page * jitPageCommandLength
 
+            let hash = start + 2 + jitPageAddressDigits + 5
             buffer[start + 0] = UInt8(ascii: "$")
             buffer[start + 1] = UInt8(ascii: "M")
             writeHexAddress(pageAddress, into: &buffer, at: start + 2)
-            buffer[start + 11] = UInt8(ascii: ",")
-            buffer[start + 12] = UInt8(ascii: "1")
-            buffer[start + 13] = UInt8(ascii: ":")
-            buffer[start + 14] = UInt8(ascii: "6")
-            buffer[start + 15] = UInt8(ascii: "9")
-            buffer[start + 16] = UInt8(ascii: "#")
-            writeChecksum(into: &buffer, bodyStart: start + 1, hashIndex: start + 16)
+            buffer[hash - 5] = UInt8(ascii: ",")
+            buffer[hash - 4] = UInt8(ascii: "1")
+            buffer[hash - 3] = UInt8(ascii: ":")
+            buffer[hash - 2] = UInt8(ascii: "6")
+            buffer[hash - 1] = UInt8(ascii: "9")
+            buffer[hash] = UInt8(ascii: "#")
+            writeChecksum(into: &buffer, bodyStart: start + 1, hashIndex: hash)
         }
 
         return buffer
     }
 
     private static func writeHexAddress(_ address: UInt64, into buffer: inout [UInt8], at index: Int) {
-        for nibble in 0..<9 {
-            let shift = UInt64((8 - nibble) * 4)
+        for nibble in 0..<jitPageAddressDigits {
+            let shift = UInt64((jitPageAddressDigits - 1 - nibble) * 4)
             buffer[index + nibble] = hexDigit(UInt8((address >> shift) & 0xf))
         }
     }
