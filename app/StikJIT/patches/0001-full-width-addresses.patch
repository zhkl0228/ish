@@ -3,22 +3,22 @@
     for (let i = 0; i < hexStr.length; i += 2) {
         bytes.push(parseInt(hexStr.substr(i, 2), 16));
     }
+    // Every byte: the low five alone cap a register at 2^40, and an app
+    // with the extended virtual addressing entitlement maps above it
     let num = 0n;
-    for (let i = 4; i >= 0; i--) {
+    for (let i = bytes.length - 1; i >= 0; i--) {
         num = (num << 8n) | BigInt(bytes[i]);
     }
     return num;
 }
 
 function numberToLittleEndianHexString(num) {
+    // All eight bytes, for the same reason
     const bytes = [];
-    for (let i = 0; i < 5; i++) {
+    for (let i = 0; i < 8; i++) {
         bytes.push(Number(num & 0xFFn));
         num >>= 8n;
     }
-    while (bytes.length < 8) {
-        bytes.push(0);
-    }
     return bytes.map(b => b.toString(16).padStart(2, '0')).join('');
 }
 
