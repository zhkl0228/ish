StikJIT 2.0.1: the script runner kept alive till its script ends. Its
closures (send_command, prepare_memory_region, log) hold it weakly, and it was
a temporary: Swift keeps one alive for the call it makes, but Xcode 27.2 warned
that the weak references would always be nil, the runner deallocated at
.run(). Bound and extended, its lifetime is the call's, said so.

diff -ruN a/Sources/JITSession.swift b/Sources/JITSession.swift
--- a/Sources/JITSession.swift
+++ b/Sources/JITSession.swift
@@ -48,7 +48,9 @@
 
         switch (forceScript, txmPresence) {
         case (true, _), (false, .present):
-            try ScriptRunner(targetPID: targetPID, debugProxy: debugProxy, script: script, progress: progress).run()
+            // The runner its closures hold weakly, alive till the script ends
+            let runner = ScriptRunner(targetPID: targetPID, debugProxy: debugProxy, script: script, progress: progress)
+            try withExtendedLifetime(runner) { try runner.run() }
         case (false, .absent):
             try attachWithoutScript(targetPID: targetPID, debugProxy: debugProxy, progress: progress)
         case (false, .unknown):
