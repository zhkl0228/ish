{
  "sourceLanguage" : "en",
  "strings" : {
    "%1$@ of the app's %2$@" : {
      "comment" : "Meter details: memory used of what iOS lets the app have",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已用 %1$@，app 上限 %2$@"
          }
        }
      }
    },
    "%1$@ of the device's %2$@" : {
      "comment" : "Meter details: memory used of the device's, with no limit",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已用 %1$@，设备共 %2$@"
          }
        }
      }
    },
    "%1$@, JIT %2$@" : {
      "comment" : "The column's meters read aloud: the strip's, then the JIT's share",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@，JIT %2$@"
          }
        }
      }
    },
    "%@, its code region full" : {
      "comment" : "The JIT gauge read aloud once the code region is full",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@，代码区已满"
          }
        }
      }
    },
    "Backspace" : {
      "comment" : "The column's esc key held: what it sends",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "退格"
          }
        }
      }
    },
    "Braked: the guest's new memory is refused (ENOMEM)" : {
      "comment" : "Meter details: the kernel's memory governor refuses new memory",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已限制：guest 新申请的内存会被拒绝（ENOMEM）"
          }
        }
      }
    },
    "CPU %1$d%%, memory %2$d%%, heat %3$@" : {
      "comment" : "The meters read aloud",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU %1$d%%，内存 %2$d%%，温度%3$@"
          }
        }
      }
    },
    "Clear the line" : {
      "comment" : "The column's / key held: what it sends (Ctrl-U)",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除整行"
          }
        }
      }
    },
    "Code region: %1$@ of %2$@" : {
      "comment" : "Meter details: the JIT's code region used, of its size",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代码区：已用 %1$@，共 %2$@"
          }
        }
      }
    },
    "Critical" : {
      "comment" : "Heat: ProcessInfo's thermal state, too hot",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "严重过热"
          }
        }
      }
    },
    "Device load %1$.2f · %2$.2f · %3$.2f" : {
      "comment" : "Meter details: the load averages over 1, 5 and 15 minutes",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设备负载 %1$.2f · %2$.2f · %3$.2f"
