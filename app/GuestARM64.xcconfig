// The app targets' settings for iSH (the app and its file provider include it)

// The targets bypass the Project{Debug,Release}.xcconfig chain, so DEBUG=1
// must be set explicitly per build configuration. Release leaves it unset so
// DEBUG-gated code (e.g. DebugServer) is fully excluded.
GCC_PREPROCESSOR_DEFINITIONS =
GCC_PREPROCESSOR_DEFINITIONS[config=Debug-ApplePleaseFixFB19282108] = DEBUG=1

// YES builds libish with the native JIT (meson -Djit=true, see
// asbestos/guest-arm64/jit.h). Translating at run time needs executable
// memory, so ISH_JIT_EMIT = YES is for development builds only; with NO the
// JIT never maps executable memory and only runs AOT images that the app
// target links in (aot_<name>.S from tools/jit_aot/gen.py, see
// asbestos/guest-arm64/aot.h). Without images it runs everything in gadgets,
// as a build with NO does.
ISH_ENABLE_JIT = YES
ISH_JIT_EMIT = NO

// ARM64 root filesystem, relative to the repository: Alpine 3.24 aarch64 with
// the preinstalled packages, built by tools/build-rootfs.sh (not in git).
ROOTFS_FILE = deps/rootfs/arm64-root.tar.gz
