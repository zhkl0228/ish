// The app targets' settings for iSH (the app and its file provider include it)

// The targets bypass the Project{Debug,Release}.xcconfig chain, so DEBUG=1
// must be set explicitly per build configuration. Release leaves it unset so
// DEBUG-gated code (e.g. DebugServer) is fully excluded.
GCC_PREPROCESSOR_DEFINITIONS =
GCC_PREPROCESSOR_DEFINITIONS[config=Debug-ApplePleaseFixFB19282108] = DEBUG=1

// YES builds libish with the native JIT (meson -Djit=true, see
// asbestos/guest-arm64/jit.h). It runs the AOT images the app target links in
// (aot_<name>.S from tools/jit_aot/gen.py, see asbestos/guest-arm64/aot.h),
// and everything else in gadgets. ISH_JIT_EMIT = YES translates the rest at
// run time too, into executable memory, which iOS lets a process run only
// once a debugger has had it (CS_DEBUGGED: Xcode, or StikDebug on the
// device), and from iOS 26 on TXM devices (A15 and M2 and later) only if the
// debugger allocated it, asked by iOS 26's JIT protocol (StikDebug's
// universal.js answers it; see asbestos/guest-arm64/jit.h). Without one the
// JIT maps none and runs as a build with NO does, which never maps it (meson
// -Djit_emit=false).
ISH_ENABLE_JIT = YES
ISH_JIT_EMIT = YES

// ARM64 root filesystem, relative to the repository: Alpine 3.24 aarch64 with
// the preinstalled packages, built by tools/build-rootfs.sh (not in git).
ROOTFS_FILE = deps/rootfs/arm64-root.tar.gz
